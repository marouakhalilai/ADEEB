<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- The Session 0 half of the client. Runs as LocalSystem. Owns policy evaluation,
       the template vault, the keys and the audit chain. Never draws UI, never opens a
       camera, never enumerates the interactive desktop (CLAUDE.md rule 18). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SecureAgent.Service</RootNamespace>
    <OutputType>Exe</OutputType>
    <UserSecretsId>secureagent-service</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecureAgent.Core\SecureAgent.Core.csproj" />
    <ProjectReference Include="..\SecureAgent.Contracts\SecureAgent.Contracts.csproj" />
    <ProjectReference Include="..\SecureAgent.Infrastructure\SecureAgent.Infrastructure.csproj" />
  </ItemGroup>

</Project>
