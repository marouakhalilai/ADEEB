<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- <clear /> drops any feed inherited from a machine- or user-level NuGet.config.
       Without it, a package can silently resolve from whatever feed happens to be
       configured on the build machine, which for a security product means the dependency
       set differs between a developer's box and CI with no visible cause. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Source mapping is the control against dependency confusion: a package only resolves
       if its id matches a pattern mapped to that source. With a single public feed this is
       cheap insurance; it becomes load-bearing the moment a private feed is added, because
       an attacker publishing an internal-looking package id to nuget.org would otherwise
       be a candidate. Add the private feed's patterns explicitly at that point — never
       leave a private feed mapped to "*". -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
