<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comment. Required on public security APIs (CLAUDE.md coding
         style) but not worth blocking on for internal types, so it warns rather than errors. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <Product>SecureAgent</Product>
    <Company>SecureAgent</Company>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <!-- Crash dumps must never contain heap memory: the broker holds camera frames and
       the service holds decrypted templates. Enforced again at runtime via WER config. -->
  <PropertyGroup>
    <DebugType>portable</DebugType>
  </PropertyGroup>

</Project>
